@model List<Tes.Models.Profile>

<h2>Data Produk</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Company Name</th>
            <th>Job Title</th>
            <th>Phone Number</th>
            <th>IdentityImage</th>
            <th>Email</th>
           
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.id</td>
                <td>@item.firstName</td>
                <td>@item.lastName</td>
                <td>@item.companyName</td>
                <td>@item.jobTitle</td>
                <td>@item.phoneNumber</td>
                <td>@item.email</td>
                <td>@item.identityImage</td>
             
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Tambah Produk</a>